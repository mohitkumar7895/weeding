# ==========================================
# WedWithMe - Production Environment Config
# ==========================================
# WARNING: NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL!
# Copy this file to .env.local or .env.production and fill in the values.

# ------------------------------------------
# Server Configuration
# ------------------------------------------
NODE_ENV=production
PORT=3000
# WhatsApp API (WWM Foundation)
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# ==========================================
# ADVANCED CUSTOM SERVER SETTINGS
# ==========================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://www.wedwithme.com,https://wedwithme.com,http://localhost:3000
# Rate Limiting (15 minutes default)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=200

# ------------------------------------------
# Database Configuration (MySQL)
# ------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wedwithme

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Generate a strong, random 64-character hex string for production (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_strong_jwt_secret
COOKIE_SECRET=replace_with_strong_cookie_secret

# ------------------------------------------
# Storage & Backups
# ------------------------------------------
BACKUP_STORAGE_PROVIDER=local
BACKUP_LOCAL_PATH=./backups
BACKUP_RETENTION_DAYS=30
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BACKUP_S3_BUCKET=

# ------------------------------------------
# External Providers (Optional/Configurable)
# ------------------------------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_SECRET=

# WHATSAPP_API_TOKEN=
# Sagun assistant (Gemini AIza… / Groq gsk_… / OpenAI sk-…). Prefer this for /api/ai/chat
SAGUN_AI_KEY=
# Optional fallbacks if SAGUN_AI_KEY is empty
# AI_API_KEY=
# AI_PROVIDER_API_KEY=
